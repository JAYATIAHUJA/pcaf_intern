{
  "name": "pcaf-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "api": "npm run start --workspace=backend",
    "start": "concurrently \"npm run dev --workspace=frontend\" \"npm run start --workspace=backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
